# ---------- Mistral (grading + transcription) ----------
MISTRAL_API_KEY=
MISTRAL_SERVER=eu
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-latest
# leave empty to auto-detect, or set e.g. de / en
TRANSCRIBE_LANGUAGE=
# mistral = Voxtral; notes = no speech-to-text, speaker notes stand in (dev only)
TRANSCRIBER=mistral

# ---------- Feedback ----------
# auto = language of the submission; de = Standard German; en = English
FEEDBACK_LANGUAGE=auto

# ---------- Server ----------
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=200
# 0 = skip slide rendering (no LibreOffice installed)
RENDER_SLIDES=1
# Uploads are processed in a temp dir that is deleted right after grading.
# Reports stay in memory for this many hours for download (0 = until restart).
REPORT_RETENTION_HOURS=1

# ---------- Reuse for another case ----------
# RUBRIC_PATH=app/rubrics/meditec_pitch.yaml
# TASK_PATH=app/rubrics/task.md
# CASE_PATH=app/rubrics/case_meditec.md
